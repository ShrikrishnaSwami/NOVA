# NOVA backend configuration
NOVA_APP_NAME=NOVA
NOVA_ENVIRONMENT=development
NOVA_HOST=127.0.0.1
NOVA_PORT=8000
NOVA_LOG_LEVEL=INFO

# AI provider
# echo = safe setup mode; openai_compatible = local model server or compatible cloud API
NOVA_AI_PROVIDER=echo
NOVA_AI_MODEL=local-model
NOVA_AI_BASE_URL=http://127.0.0.1:1234/v1
NOVA_AI_API_KEY=
NOVA_AI_TIMEOUT_SECONDS=60

# Response performance
# Limits output length; raise to 1024-2048 for longer answers or coding tasks.
NOVA_AI_MAX_TOKENS=512
# Number of previous user/assistant messages included in each prompt (0-20).
NOVA_AI_CONTEXT_MESSAGES=8
# Qwen3 non-thinking mode is faster; users can still put /think in a message.
NOVA_AI_QWEN_NO_THINK=true
NOVA_AI_TOP_P=0.8

# Local SQLite memory database (defaults to ~/.nova/nova_memory.sqlite3)
NOVA_MEMORY_DB_PATH=~/.nova/nova_memory.sqlite3

# Optional offline voice input; set to the extracted Vosk model directory.
# NOVA_VOSK_MODEL_PATH=C:\\NOVA\\models\\vosk-model-small-en-us-0.15

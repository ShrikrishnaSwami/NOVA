# NOVA backend configuration
NOVA_APP_NAME=NOVA
NOVA_ENVIRONMENT=production
NOVA_HOST=127.0.0.1
NOVA_PORT=8000
NOVA_LOG_LEVEL=INFO

# Local Bionic runtime (OpenAI-compatible API)
NOVA_AI_PROVIDER=openai_compatible
NOVA_AI_MODEL=qwen3-1.7b
NOVA_AI_BASE_URL=http://127.0.0.1:1235/v1
NOVA_AI_API_KEY=
NOVA_AI_TIMEOUT_SECONDS=120

# Response performance
NOVA_AI_MAX_TOKENS=512
NOVA_AI_CONTEXT_MESSAGES=8
NOVA_AI_QWEN_NO_THINK=true
NOVA_AI_TOP_P=0.8

# Memory is stored in the current Windows user's Local AppData by default.
# Override only if you want to move it elsewhere.
# NOVA_MEMORY_DB_PATH=C:\Users\YourName\AppData\Local\NOVA\nova_memory.sqlite3

# Computer controls: by default NOVA discovers accessible local drives.
# Set this only if you want to narrow access to specific folders.
# NOVA_COMPUTER_ALLOWED_ROOTS=C:\Users\YourName\Documents;C:\Users\YourName\Desktop

# Optional offline voice input; set to the extracted Vosk model directory.
# NOVA_VOSK_MODEL_PATH=C:\NOVA\models\vosk-model-small-en-us-0.15
# Optional single-laptop distributed runtime (requires Docker Desktop + Compose).
# Enable only after starting the local Compose cluster.
# NOVA_DISTRIBUTED_ENABLED=false
# NOVA_NATS_URL=nats://127.0.0.1:4222
# NOVA_NODE_ID=nova-windows-host
